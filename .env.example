# Copy this file to ".env" and fill in your keys (both are free).
#   cp .env.example .env
#
# Agent LLM runs on Groq (reliable tool-calling).  Free key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
#
# Patient-summary embeddings run on Google Gemini.  Free key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# Optional override of the data folder:
# HEALTHCARE_DATA=Data
